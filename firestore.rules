rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can view the Stokvel records without signing in.
    // Only the admin, signed in with Google, can add, change or delete them.
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['joendowmathoma@gmail.com'];
    }

    match /payments/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.memberId is string
        && request.resource.data.date is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount < 1000000;
    }
    match /members/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 100;
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
