rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // No sign-in: anyone with the link can read and write the Stokvel records.
    // Writes are limited to well-formed records in these three collections.
    match /payments/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.memberId is string
        && request.resource.data.date is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount < 1000000;
    }
    match /members/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 100;
    }
    match /settings/{id} {
      allow read, write: if true;
    }
  }
}
